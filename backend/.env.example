# Backend environment variables
# Copy this file to .env and fill in your values

# Mapbox API token (for satellite imagery in land detection)
# Get one at https://account.mapbox.com/ — free tier includes 5,000 Static Images/month
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiWU9VUl9VU0VSTkFNRSIsImEiOiJZT1VSX1RPS0VOIn0.YOUR_SIGNATURE

# Satellite imagery provider: "mapbox" or "esri" (ESRI is free, no key needed)
SATELLITE_PROVIDER=mapbox

# ── OpenTelemetry (OTel Phase 4) ──────────────────────────────────────────────
# OTel Collector gRPC endpoint (default: local docker compose stack)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Service version exported in every span/metric/log
OTEL_SERVICE_VERSION=0.2.0

# Deployment environment tag (development / staging / production)
OTEL_DEPLOYMENT_ENVIRONMENT=development

# Set to "false" to disable all telemetry (e.g. in unit tests)
OTEL_ENABLED=true
